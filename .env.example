# Copy to .env and fill in. Never commit the real .env - it is gitignored.

# Roboflow API key, used only by training/download_datasets.py.
# Free key: https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# --- Paths (all optional; defaults are relative to the repository root) ---
# EPF_PROJECT_ROOT=/path/to/emergency-path-finder
# EPF_DATASETS_DIR=/mnt/data/epf-datasets
# EPF_MODELS_DIR=/mnt/data/epf-models
# EPF_FLUTTER_ASSETS_DIR=/path/to/flutter_app/assets/models

# Explicit weights to run inference with. When unset, the newest
# ml_models/**/weights/best.pt is used, and if there is none the app falls back
# to classical computer vision.
# EPF_MODEL_PATH=ml_models/exit_detector/weights/best.pt

# --- Detection tuning (optional) ---
# EPF_INPUT_SIZE=416
# EPF_CONFIDENCE_THRESHOLD=0.35
# EPF_NMS_IOU_THRESHOLD=0.45
# EPF_BRIGHTNESS_THRESHOLD=200
# EPF_MIN_SIGN_AREA_RATIO=0.0015
# EPF_MIN_DOOR_AREA_RATIO=0.02
